# ==========================================
# Variables de Entorno - Minutas
# ==========================================
# Copia este archivo como `.env` o `.env.local` y reemplaza los valores:
#   cp .env.example .env
#
# Opción 1: Proyecto Remoto en Supabase Cloud
# Obtén tus credenciales en https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opción 2: Supabase Local (Docker CLI)
# Si ejecutas `npm run supabase:start`, descomenta las siguientes líneas:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=tu-anon-key-local

# Opción 3: Servidor Local WhatsApp Bot (Opcional, por defecto http://localhost:3001)
# VITE_WHATSAPP_BOT_URL=http://localhost:3001
