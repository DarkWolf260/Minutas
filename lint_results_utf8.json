  settingsLoaded &&\r\n      settings.activeGuardId &&\r\n      selectedGuardId !== settings.activeGuardId &&\r\n      guardsLoaded &&\r\n      guards.some((g) => g.id === settings.activeGuardId)\r\n    ) {\r\n      setSelectedGuardId(settings.activeGuardId);\r\n    }\r\n  }, [settings, settingsLoaded, guards, guardsLoaded, selectedGuardId]);\r\n\r\n  const handleActiveGuardChange = (guardId: string) => {\r\n    if (!guardId) return;\r\n    setSelectedGuardId(guardId);\r\n    saveSettings({ ...settings, activeGuardId: guardId });\r\n  };\r\n\r\n  const selectedGuardForForm = guards.find((g) => g.id === selectedGuardId);\r\n  const isLoaded = guardsLoaded && rolesLoaded && settingsLoaded;\r\n\r\n  if (!isLoaded) {\r\n    return (\r\n      <div className=\"p-4 sm:p-6 lg:p-8 space-y-6\">\r\n        <Skeleton className=\"h-10 w-full max-w-sm mx-auto mb-4\" />\r\n        <Skeleton className=\"h-96 w-full max-w-4xl mx-auto\" />\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto space-y-6\">\r\n      <div>\r\n        <h1 className=\"text-3xl font-bold tracking-tight\">Orden del D├¡a</h1>\r\n        <p className=\"text-muted-foreground\">\r\n          Genera el reporte diario de operaciones para la guardia activa.\r\n        </p>\r\n      </div>\r\n\r\n      <Card className=\"shadow-lg\">\r\n        <CardHeader>\r\n          <CardTitle>Generar Orden del D├¡a</CardTitle>\r\n          <CardDescription>\r\n            Selecciona una guardia para generar su reporte. Esta selecci├│n definir├í la guardia\r\n            activa para el reporte de cierre.\r\n          </CardDescription>\r\n        </CardHeader>\r\n        <CardContent>\r\n          <div className=\"space-y-4\">\r\n            <div className=\"space-y-2 max-w-xs\">\r\n              <Label\r\n                htmlFor=\"guard-select\"\r\n                className=\"text-xs uppercase font-bold text-muted-foreground\"\r\n              >\r\n                Guardia Activa Actual\r\n              </Label>\r\n              <Select value={selectedGuardId} onValueChange={handleActiveGuardChange}>\r\n                <SelectTrigger id=\"guard-select\" className=\"h-10\">\r\n                  <SelectValue placeholder=\"Selecciona una guardia...\" />\r\n                </SelectTrigger>\r\n                <SelectContent>\r\n                  {guards.map((guard) => (\r\n                    <SelectItem key={guard.id} value={guard.id}>\r\n                      Guardia \"{guard.id}\"\r\n                    </SelectItem>\r\n                  ))}\r\n                </SelectContent>\r\n              </Select>\r\n            </div>\r\n\r\n            {selectedGuardId ? (\r\n              <OrdenDelDiaForm\r\n                selectedGuard={selectedGuardId}\r\n                initialData={selectedGuardForForm?.staff}\r\n              />\r\n            ) : (\r\n              <div className=\"text-center py-12 border-2 border-dashed rounded-lg bg-muted/30\">\r\n                <p className=\"text-muted-foreground\">\r\n                  Por favor, selecciona una guardia para empezar.\r\n                </p>\r\n                {guards.length === 0 && (\r\n                  <p className=\"text-xs mt-2\">\r\n                    No hay guardias definidas. Ve a{' '}\r\n                    <Link href=\"/personal\" className=\"text-primary font-bold hover:underline\">\r\n                      Gesti├│n de Personal\r\n                    </Link>{' '}\r\n                    para crearlas.\r\n                  </p>\r\n                )}\r\n              </div>\r\n            )}\r\n          </div>\r\n        </CardContent>\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\Documents\\GitHub\\Minutas\\src\\app\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Da