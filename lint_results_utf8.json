:0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\Documents\\GitHub\\Minutas\\src\\app\\documentation\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\Documents\\GitHub\\Minutas\\src\\app\\documentation\\roadmap\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\Documents\\GitHub\\Minutas\\src\\app\\documentation\\template-engine\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\Documents\\GitHub\\Minutas\\src\\app\\documentation\\user-guide\\page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'CheckSquare' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":25,"messageId":"unusedVar","endLine":6,"endColumn":36,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CheckSquare"},"fix":{"range":[264,277],"text":""},"desc":"Remove unused variable \"CheckSquare\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Square' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":38,"messageId":"unusedVar","endLine":6,"endColumn":44,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Square"},"fix":{"range":[277,285],"text":""},"desc":"Remove unused variable \"Square\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\r\n\r\nimport { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';\r\nimport { Badge } from '@/components/ui/badge';\r\nimport { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';\r\nimport { AlertTriangle, CheckSquare, Square } from 'lucide-react';\r\n\r\nconst Code = ({ children }: { children: React.ReactNode }) => (\r\n  <code className=\"relative rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-sm font-semibold text-card-foreground\">\r\n    {children}\r\n  </code>\r\n);\r\n\r\nconst DocSection = ({\r\n  title,\r\n  description,\r\n  children,\r\n}: {\r\n  title: string;\r\n  description: string;\r\n  children: React.ReactNode;\r\n}) => (\r\n  <section className=\"space-y-4\">\r\n    <div className=\"border-l-4 border-primary pl-4\">\r\n      <h2 className=\"text-xl font-semibold\">{title}</h2>\r\n      <p className=\"text-muted-foreground mt-1\">{description}</p>\r\n    </div>\r\n    <div className=\"space-y-6 pl-5 border-l-4 border-transparent\">{children}</div>\r\n  </section>\r\n);\r\n\r\n\r\n\r\nexport default function UserGuidePage() {\r\n\r\n\r\n  return (\r\n    <div className=\"p-4 sm:p-6 lg:p-8\">\r\n      <div className=\"max-w-4xl mx-auto\">\r\n        <Card className=\"shadow-lg\">\r\n          <CardHeader>\r\n            <CardTitle>Gu├¡a de Usuario del Sistema</CardTitle>\r\n            <CardDescription>\r\n              Una gu├¡a detallada sobre c├│mo funcionan el guardado de datos y el renderizado de\r\n              reportes en la aplicaci├│n.\r\n            </CardDescription>\r\n          </CardHeader>\r\n          <CardContent className=\"space-y-12 pt-6\">\r\n            <Alert variant=\"destructive\">\r\n              <AlertTriangle className=\"h-4 w-4\" />\r\n              <AlertTitle>Aviso: Documentaci├│n en Revisi├│n</AlertTitle>\r\n              <AlertDescription>\r\n                Esta documentaci├│n fue generada por una inteligencia artificial para proporcionar\r\n                una gu├¡a inicial. Actualmente est├í siendo revisada y validada por el desarrollador.\r\n              </AlertDescription>\r\n            </Alert>\r\n            <DocSection\r\n              title=\"1. Sistema de Guardado y Prioridad de Datos\"\r\n              description=\"Entender c├│mo y cu├índo se guardan los datos es clave para sacar el m├íximo provecho a la aplicaci├│n.\"\r\n            >\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">┬┐Qu├® se guarda realmente?</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Cuando creas o editas una novedad, la aplicaci├│n no guarda simplemente el texto\r\n                  final del reporte. En su lugar, guarda un objeto con los{' '}\r\n                  <strong>datos estructurados</strong> que rellenaste en el formulario.\r\n                </p>\r\n                <p className=\"text-muted-foreground leading-relaxed mt-2\">\r\n                  A diferencia del almacenamiento tradicional del navegador, ahora usamos{' '}\r\n                  <strong>RxDB (v1) sobre IndexedDB</strong>. Este sistema avanzado organiza los\r\n                  datos en colecciones tipadas (personnel, reports, settings) y soporta migraciones\r\n                  autom├íticas para que nunca pierdas informaci├│n al actualizar la app.\r\n                </p>\r\n                <pre className=\"mt-3 p-3 bg-muted rounded-md text-xs font-mono whitespace-pre-wrap\">\r\n                  {`{\r\n\"id\": \"report_1769465028850\",\r\n\"Hora\": \"14:30 HLV\",\r\n\"Lugar\": \"Plaza Bol├¡var\",\r\n\"timestamp\": \"2026-01-26T18:12:10Z\"\r\n}`}\r\n                </pre>\r\n                <p className=\"text-muted-foreground leading-relaxed mt-3\">\r\n                  El texto del reporte se regenera din├ímicamente a partir de estos datos y la\r\n                  plantilla cada vez que lo visualizas. Esto asegura que si actualizas una\r\n                  plantilla, los reportes antiguos se adaptar├ín autom├íticamente.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">La Regla de Prioridad de los Datos</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  El sistema sigue un orden estricto de prioridades para decidir qu├® valor mostrar\r\n                  en un campo del formulario. Esto es fundamental para entender por qu├® un campo\r\n                  predefinido a veces se puede editar y otras no:\r\n                </p>\r\n                <ol className=\"list-decimal list-inside mt-4 space-y-4 text-muted-foreground\">\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      El Valor Guardado en el Reporte (M├íxima Prioridad)\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Si introduces manualmente un valor en un campo (incluso en uno predefinido\r\n                      como <Code>{'{Municipio}'}</Code>) y guardas el reporte,{' '}\r\n                      <strong>ESE valor tiene la m├íxima prioridad</strong>. Siempre se mostrar├í la\r\n                      pr├│xima vez que abras ese reporte espec├¡fico, sin importar si cambias el valor\r\n                      en la configuraci├│n global.\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      El Valor Global Predefinido\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Si un campo en tu reporte est├í vac├¡o (porque es un reporte nuevo, o porque\r\n                      nunca lo rellenaste), la aplicaci├│n intentar├í rellenarlo con el valor que\r\n                      hayas configurado en{' '}\r\n                      <Badge variant=\"outline\">Plantillas {'>'} Etiquetas Globales</Badge>. Este es\r\n                      el valor \"por defecto\".\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      El Valor Din├ímico (Configuraci├│n Multi-rol)\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Algunas etiquetas, como <Code>{'{Reporta}'}</Code> y{' '}\r\n                      <Code>{'{Analista}'}</Code>, no tienen un valor fijo. Su contenido se genera\r\n                      autom├íticamente basado en la <strong>lista de cargos priorizados</strong> que\r\n                      hayas configurado en <Badge variant=\"outline\">Configuraci├│n</Badge>. El sistema\r\n                      busca en la guardia activa al personal que ostente el primer cargo de tu lista;\r\n                      si no hay nadie, pasa al segundo, y as├¡ sucesivamente.\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">Campo Vac├¡o</span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Si no hay un valor guardado en el reporte para ese campo, ni tampoco un valor\r\n                      global o din├ímico, el campo simplemente se mostrar├í vac├¡o, listo para que lo\r\n                      rellenes.\r\n                    </p>\r\n                  </li>\r\n                </ol>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">\r\n                  ┬┐Cu├índo se guardan los datos? El Sistema H├¡brido\r\n                </h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Para ofrecer flexibilidad y seguridad, la aplicaci├│n utiliza un sistema de\r\n                  guardado h├¡brido que combina el control manual con un respaldo autom├ítico:\r\n                </p>\r\n                <ol className=\"list-decimal list-inside mt-4 space-y-4 text-muted-foreground\">\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Autoguardado (Tu Red de Seguridad)\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      El sistema realiza un guardado autom├ítico <strong>30 segundos despu├®s</strong>{' '}\r\n                      de que dejas de escribir. Esto funciona tanto al crear una novedad como al\r\n                      editar una existente. Piensa en ello como una red de seguridad que protege tu\r\n                      trabajo de interrupciones o cierres accidentales.\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Guardado Manual (Tu Control)\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Para cambios importantes o para asegurarte de que todo est├í registrado antes\r\n                      de salir, puedes usar el bot├│n{' '}\r\n                      <Badge variant=\"secondary\">Guardar Cambios</Badge>. Esto guarda tus cambios de\r\n                      forma inmediata.\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Guardado al Navegar (Protecci├│n Total)\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Para evitar cualquier p├®rdida de datos, la aplicaci├│n fuerza un guardado de\r\n                      todos los cambios pendientes en el instante en que cambias a otro reporte o\r\n                      navegas a una p├ígina diferente (como \"Plantillas\" o \"Configuraci├│n\"). Esto\r\n                      garantiza que tu ├║ltimo cambio, sin importar cu├ín reciente sea, siempre quede\r\n                      registrado.\r\n                    </p>\r\n                  </li>\r\n                </ol>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">\r\n                  El Beneficio: Flexibilidad y Confianza\r\n                </h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Este sistema combinado te da lo mejor de ambos mundos: puedes definir valores\r\n                  globales para agilizar el trabajo diario, pero mantienes la flexibilidad de\r\n                  sobrescribir esos valores para un reporte espec├¡fico. Al mismo tiempo, el sistema\r\n                  de guardado h├¡brido te da la confianza de que tu trabajo est├í seguro sin necesidad\r\n                  de estar guardando manualmente a cada instante.\r\n                </p>\r\n              </div>\r\n            </DocSection>\r\n            <DocSection\r\n              title=\"2. L├│gica de Renderizado de Reportes\"\r\n              description=\"El texto final de un reporte se genera combinando tu plantilla con los datos del formulario. As├¡ funciona el proceso.\"\r\n            >\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">\r\n                  El Concepto Base: Plantilla + Datos = Reporte\r\n                </h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  El motor de renderizado toma el texto de tu plantilla <Code>.txt</Code> y lo\r\n                  recorre buscando \"etiquetas\" o \"secciones\" especiales para reemplazarlas con los\r\n                  datos correspondientes que has guardado.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Reemplazo de Etiquetas Simples</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Cualquier texto encerrado entre llaves, como <Code>{'{Hora}'}</Code>, se busca en\r\n                  los datos guardados. Si se encuentra un valor para \"Hora\", la etiqueta completa se\r\n                  reemplaza por ese valor. Si el valor es una fecha (YYYY-MM-DD), se formatea\r\n                  autom├íticamente a <Code>DD/Mes/AAAA</Code>. Si no se encuentra ning├║n valor, la\r\n                  etiqueta se reemplaza por una cadena vac├¡a, limpiando el reporte final.\r\n                </p>\r\n                <p className=\"text-muted-foreground leading-relaxed mt-2\">\r\n                  <strong>Nombres de campo especiales:</strong> si nombras un campo exactamente{' '}\r\n                  <Code>{'{C├®dula}'}</Code>, se convertir├í en un campo de texto con formato\r\n                  autom├ítico para c├®dulas venezolanas. Si lo nombras <Code>{'{Unidad}'}</Code>, se\r\n                  convertir├í en un selector con las unidades que hayas registrado en Configuraci├│n.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">\r\n                  Sintaxis Avanzada de Etiquetas (Tipos y Dropdowns)\r\n                </h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Adem├ís del reemplazo simple, puedes dotar a tus etiquetas de mayor inteligencia\r\n                  especificando el tipo de campo que deben generar en el formulario. Esto te da m├ís\r\n                  control directamente desde el archivo <code>.txt</code>.\r\n                </p>\r\n                <ul className=\"list-disc list-inside mt-4 space-y-4 text-muted-foreground\">\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Especificar Tipo de Campo\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Usa dos puntos (<code>:</code>) despu├®s del nombre del campo para asignar un\r\n                      tipo: <Code>{'{NombreCampo:tipo}'}</Code>. Esto cambia c├│mo se muestra el\r\n                      campo en el formulario.\r\n                    </p>\r\n                    <ul className=\"list-disc list-inside pl-12 mt-2 space-y-1\">\r\n                      <li>\r\n                        <Code>{'{Descripci├│n:textarea}'}</Code>: Crea un ├írea de texto grande.\r\n                      </li>\r\n                      <li>\r\n                        <Code>{'{Fecha de Suceso:date}'}</Code>: Muestra un selector de calendario.\r\n                      </li>\r\n                      <li>\r\n                        <Code>{'{Hora de Llamada:time-hlv}'}</Code>: Usa el campo especial para Hora\r\n                        Legal Venezolana.\r\n                      </li>\r\n                      <li>\r\n                        <Code>{'{Tipo de Novedad:dropdown}'}</Code>: Convierte el campo en un\r\n                        selector de opciones.\r\n                      </li>\r\n                    </ul>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Definir Opciones para Dropdown\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Para un campo de tipo <code>dropdown</code>, puedes definir sus opciones y el\r\n                      texto que insertar├ín directamente en la plantilla.\r\n                    </p>\r\n                    <pre className=\"mt-3 ml-6 p-3 bg-muted rounded-md text-xs font-mono whitespace-pre-wrap\">\r\n                      {`{Motivo:dropdown(Llamada Radio=Se recibe llamada v├¡a radio.|Llamada Telef├│nica=Se recibe llamada telef├│nica.)}`}\r\n                    </pre>\r\n                    <p className=\"pl-6 mt-3 leading-relaxed\">\r\n                      La sintaxis es{' '}\r\n                      <code>(Opci├│n 1=Texto a insertar 1|Opci├│n 2=Texto a insertar 2)</code>. Al\r\n                      seleccionar \"Llamada Radio\" en el formulario, el texto \"Se recibe llamada v├¡a\r\n                      radio.\" se usar├í en el reporte. Si el dropdown est├í configurado para rellenar\r\n                      otro campo, este texto se insertar├í en el campo de destino especificado.\r\n                    </p>\r\n                  </li>\r\n                </ul>\r\n                <p className=\"text-muted-foreground leading-relaxed mt-4\">\r\n                  <strong>Importante:</strong> Si defines el tipo o las opciones de un campo en la\r\n                  plantilla, estas configuraciones tendr├ín prioridad y deshabilitar├ín las opciones\r\n                  correspondientes en el editor visual de la p├ígina de \"Plantillas\", evitando as├¡\r\n                  conflictos.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Procesamiento de Secciones</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Las secciones, definidas por corchetes <Code>[ ]</Code>, se manejan de manera m├ís\r\n                  inteligente.\r\n                </p>\r\n                <ul className=\"list-disc list-inside mt-4 space-y-4 text-muted-foreground\">\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Secciones Simples: <Code>{'[\"T├¡tulo\" {Campo1}]'}</Code>\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      El sistema primero elimina el t├¡tulo (<Code>\"T├¡tulo\"</Code>) y luego reemplaza\r\n                      cada campo (<Code>{'{Campo1}'}</Code>) con su valor correspondiente. Si{' '}\r\n                      <strong>ninguno</strong> de los campos dentro de la secci├│n tiene un valor,\r\n                      toda la secci├│n (incluyendo el texto que la rodea dentro de los corchetes) se\r\n                      elimina del reporte final para no dejar l├¡neas vac├¡as.\r\n                    </p>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">\r\n                      Secciones Repetibles: <Code>[singular=\"...\" plural=\"...\" ...]</Code>\r\n                    </span>\r\n                    <p className=\"pl-6 mt-1\">\r\n                      Para estas secciones, el sistema verifica si hay una lista de elementos\r\n                      guardada. Si la lista est├í vac├¡a, toda la secci├│n se omite. Si hay elementos:\r\n                    </p>\r\n                    <ol className=\"list-decimal list-inside pl-12 mt-2 space-y-1\">\r\n                      <li>\r\n                        Se a├▒ade el t├¡tulo principal (<Code>singular</Code> para 1 elemento,{' '}\r\n                        <Code>plural</Code> para m├ís de 1).\r\n                      </li>\r\n                      <li>Se itera sobre cada elemento de la lista.</li>\r\n                      <li>\r\n                        Por cada elemento, se genera una copia del contenido de la secci├│n y se\r\n                        reemplazan las etiquetas con los datos de ese elemento en particular.\r\n                      </li>\r\n                      <li>\r\n                        El resultado de cada elemento se une, creando la lista final en el reporte.\r\n                      </li>\r\n                    </ol>\r\n                  </li>\r\n                  <li>\r\n                    <span className=\"font-semibold text-card-foreground\">Secciones Especiales</span>\r\n                    <ul className=\"list-disc list-inside pl-6 mt-2 space-y-1\">\r\n                      <li>\r\n                        <Code>[\"\"]</Code>: Se interpreta como un separador y simplemente se elimina,\r\n                        creando un salto de l├¡nea en el reporte final.\r\n                      </li>\r\n                      <li>\r\n                        <Code>[\"T├¡tulo Informativo\"]</Code>: Si una secci├│n solo tiene un t├¡tulo y\r\n                        ning├║n campo, se renderiza como un encabezado:{' '}\r\n                        <Code>{'- *T├¡tulo Informativo*'}</Code>.\r\n                      </li>\r\n                    </ul>\r\n                  </li>\r\n                </ul>\r\n              </div>\r\n            </DocSection>\r\n            <DocSection\r\n              title=\"3. Gesti├│n de Personal y Datos\"\r\n              description=\"Herramientas avanzadas para mantener actualizada tu base de datos de personal.\"\r\n            >\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Control de Duplicados (C├®dula)</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Para mantener la integridad de los datos, el sistema utiliza la{' '}\r\n                  <strong>C├®dula</strong> como identificador ├║nico. Si intentas a├▒adir a una persona\r\n                  cuya c├®dula ya existe (ya sea manualmente o v├¡a CSV), el sistema te avisar├í. En el\r\n                  caso de las importaciones masivas, los duplicados se omiten autom├íticamente y se\r\n                  genera un reporte del n├║mero de personas a├▒adidas vs. omitidas.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Acciones Masivas y Selecci├│n</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  La tabla de personal permite seleccionar m├║ltiples filas usando las casillas a la\r\n                  izquierda. Esto habilita el bot├│n de <strong>\"Borrar seleccionados\"</strong>, que\r\n                  permite realizar limpiezas r├ípidas de la base de datos tras una confirmaci├│n de\r\n                  seguridad.\r\n                </p>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Importaci├│n de CSV Robusta</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  El importador ha sido mejorado para ser compatible con una amplia gama de\r\n                  configuraciones regionales y editores (Excel, Notepad, Google Sheets). Soporta:\r\n                </p>\r\n                <ul className=\"list-disc list-inside mt-2 space-y-1 text-muted-foreground\">\r\n                  <li>\r\n                    Delimitadores autom├íticos (Coma <code>,</code> o Punto y Coma <code>;</code>).\r\n                  </li>\r\n                  <li>Codificaci├│n UTF-8 con o sin BOM.</li>\r\n                  <li>Diferentes finales de l├¡nea (Windows y Unix).</li>\r\n                </ul>\r\n              </div>\r\n            </DocSection>\r\n            <DocSection\r\n              title=\"4. Instalaci├│n y Uso Offline (PWA)\"\r\n              description=\"La aplicaci├│n ahora funciona como una app nativa en tu dispositivo.\"\r\n            >\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">┬┐C├│mo instalar la aplicaci├│n?</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Al ser una PWA (Progressive Web App), puedes instalarla sin pasar por una tienda\r\n                  de aplicaciones:\r\n                </p>\r\n                <ul className=\"list-disc list-inside mt-2 space-y-2 text-muted-foreground\">\r\n                  <li>\r\n                    <strong>En computadoras:</strong> Busca el icono de \"Instalar\" (un monitor con\r\n                    una flecha) en la parte derecha de la barra de direcciones de Chrome o Edge.\r\n                  </li>\r\n                  <li>\r\n                    <strong>En Android:</strong> Abre el men├║ del navegador (tres puntos) y\r\n                    selecciona \"Instalar aplicaci├│n\" o \"A├▒adir a pantalla de inicio\".\r\n                  </li>\r\n                  <li>\r\n                    <strong>En iOS (iPhone/iPad):</strong> Pulsa el bot├│n \"Compartir\" y selecciona\r\n                    \"A├▒adir a pantalla de inicio\".\r\n                  </li>\r\n                </ul>\r\n              </div>\r\n              <div>\r\n                <h3 className=\"font-semibold text-lg mb-2\">Funcionamiento sin Internet</h3>\r\n                <p className=\"text-muted-foreground leading-relaxed\">\r\n                  Gracias a la tecnolog├¡a de Service Workers, la aplicaci├│n guarda sus archivos\r\n                  b├ísicos en el dispositivo. Esto significa que:\r\n                </p>\r\n                <ul className=\"list-disc list-inside mt-2 space-y-2 text-muted-foreground\">\r\n                  <li>La aplicaci├│n cargar├í incluso si no tienes conexi├│n a internet.</li>\r\n                  <li>\r\n                    Toda tu base de datos de personal y reportes est├í guardada localmente en una\r\n                    base de datos persistente.\r\n                  </li>\r\n                  <li>\r\n                    Puedes seguir creando y editando reportes mientras est├ís en el campo sin se├▒al.\r\n                  </li>\r\n                </ul>\r\n                <Alert className=\"mt-4 bg-primary/5 border-primary/20\">\r\n                  <AlertDescription>\r\n                    <strong>Protip:</strong> Una vez instalada, la aplicaci├│n tendr├í su propio icono\r\n                    en tu escritorio o pantalla de aplicaciones, abri├®ndose en una ventana limpia\r\n                    sin las barras del navegador.\r\n                  </AlertDescription>\r\n                </Alert>\r\n              </div>\r\n            </DocSection>\r\n          </CardContent>\r\n        </Card>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Dark\\D